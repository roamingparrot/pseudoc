// keep asking until the password is right, but give up after three tries
DECLARE attempts : INTEGER
DECLARE guess : STRING
attempts <- 0
REPEAT
    INPUT guess
    attempts <- attempts + 1
    IF guess <> "secret" AND attempts < 3 THEN
        OUTPUT "wrong, try again"
    ENDIF
UNTIL guess = "secret" OR attempts = 3
IF guess = "secret" THEN
    OUTPUT "welcome after ", attempts, " attempt(s)"
ELSE
    OUTPUT "locked out"
ENDIF
