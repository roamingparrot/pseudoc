DECLARE marks : ARRAY[1:5] OF INTEGER
DECLARE names : ARRAY[1:3] OF STRING
FOR i <- 1 TO 5
    marks[i] <- i * i
NEXT i
total <- 0
FOR i <- 1 TO 5
    total <- total + marks[i]
NEXT i
OUTPUT "total ", total
OUTPUT marks[1], " ", marks[5]
names[1] <- "Ann"
names[2] <- "Bo"
names[3] <- "Cy"
FOR i <- 3 TO 1 STEP -1
    OUTPUT names[i]
NEXT i
// find the largest value
largest <- marks[1]
FOR i <- 2 TO 5
    IF marks[i] > largest THEN
        largest <- marks[i]
    ENDIF
NEXT i
OUTPUT "largest ", largest
