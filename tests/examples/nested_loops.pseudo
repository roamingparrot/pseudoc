// multiplication table with nested FOR loops
FOR row <- 1 TO 3
    FOR col <- 1 TO 4
        OUTPUT row * col, " "
    NEXT col
    OUTPUT "--"
NEXT row
// loops inside conditionals inside loops
FOR i <- 1 TO 6
    IF i MOD 2 = 0 THEN
        FOR j <- i TO i + 1
            OUTPUT i, "-", j
        NEXT j
    ENDIF
NEXT i
