FOR n <- 1 TO 4
    CASE OF n
        1 : OUTPUT "one"
        2 : OUTPUT "two"
        3 :
            OUTPUT "three"
            OUTPUT "(a crowd)"
        OTHERWISE : OUTPUT "other"
    ENDCASE
NEXT n
grade <- "B"
CASE OF grade
    "A" : OUTPUT "top"
    "B" : OUTPUT "good"
ENDCASE
CASE OF 7 MOD 4
    3 : OUTPUT "remainder three"
ENDCASE
// ranges and lists of values
FOR mark <- 40 TO 100 STEP 20
    CASE OF mark
        80 TO 100 : OUTPUT mark, " A"
        50 TO 79 : OUTPUT mark, " B"
        OTHERWISE : OUTPUT mark, " C"
    ENDCASE
NEXT mark
letter <- "e"
CASE OF letter
    "a", "e", "i", "o", "u" : OUTPUT "vowel"
    OTHERWISE : OUTPUT "consonant"
ENDCASE
